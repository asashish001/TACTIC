# ── Security & Authentication ──────────────────────────────────
# In production, specify 64+ hex character cryptographically random secrets:
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Token lifetimes (optional defaults: 8 hours access, 7 days refresh)
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS & Network Security ────────────────────────────────────
# Comma-separated list of allowed origins. If empty, same-origin applies.
# Example: http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Forensic Evidence Ingestion & Limits ───────────────────────
# Maximum evidence upload file size in bytes (default: 524288000 = 500 MB)
MAX_UPLOAD_BYTES=524288000

# ── Timezone Normalization ─────────────────────────────────────
# Baseline fallback timezone for normalizing forensic evidence timestamps without offsets.
# Supported: UTC, IST, EST, EDT, CST, CDT, MST, MDT, PST, PDT, GMT, CET, CEST, JST, AEST, AEDT or IANA tz (e.g., Asia/Kolkata)
DEFAULT_TIMEZONE=UTC

# ── Database Configuration ─────────────────────────────────────
DATABASE_URL=sqlite:///app/database/forensics.db

# Database Pool Settings (For PostgreSQL/MySQL production deployments; SQLite uses StaticPool and ignores these):
DB_POOL_SIZE=5            # connections kept in pool
DB_MAX_OVERFLOW=10        # extra connections beyond pool_size
DB_POOL_TIMEOUT=30        # seconds to wait for a connection
DB_POOL_RECYCLE=1800      # seconds before recycling idle connections
DB_POOL_PRE_PING=true     # test connections before use (detects dead connections)

# ── Default Administrator Account ──────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
# Password policy:
# - For local development/demo parity: ChangeMe123!
# - If left empty, a secure random password is generated and logged once to stdout on startup.
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ── AI Provider & RAG Forensic Chat ────────────────────────────
# Options: disabled, gemini, openai, ollama
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# ── Local AI / NLP & Offline Settings ──────────────────────────
NLP_MODEL_NAME=dslim/bert-base-NER
# Set these to "1" to run HuggingFace inference purely offline
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ── Threat Intelligence Service ────────────────────────────────
# Set to "true" to enable external reputation lookups for IP/domain/hash IoCs
THREAT_INTEL_REMOTE_LOOKUPS=false

# ── Test Suite & Integration ───────────────────────────────────
# Base URL used by integration and live server verification tests
AIDFA_BASE_URL=http://127.0.0.1:8000
