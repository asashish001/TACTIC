[TEMPLATE]
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///app/database/forensics.db

# ── Database Pool Settings ─────────────────────────────────────
# For PostgreSQL/MySQL production deployments.
# SQLite uses a StaticPool; these are ignored.
DB_POOL_SIZE=5            # connections kept in pool
DB_MAX_OVERFLOW=10        # extra connections beyond pool_size
DB_POOL_TIMEOUT=30        # seconds to wait for a connection
DB_POOL_RECYCLE=1800      # seconds before recycling idle connections
DB_POOL_PRE_PING=true     # test connections before use (detects dead connections)

DEFAULT_ADMIN_USERNAME=admin
# REQUIRED: Set a strong password here before first run.
# If left empty or set to an insecure default, a random password
# will be generated and printed to the console on first start.
DEFAULT_ADMIN_PASSWORD=
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
THREAT_INTEL_REMOTE_LOOKUPS=false
